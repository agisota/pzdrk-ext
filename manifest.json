{
  "manifest_version": 3,
  "name": "✦ pzdrk",
  "version": "6.4.0",
  "description": "AI анализ • Privacy • Mindmap • Glass UI",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "tabs",
    "history",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webRequest",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "pzdrk_blocklist",
      "enabled": true,
      "path": "rules/blocklist.json"
    }]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/pzdrk.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
