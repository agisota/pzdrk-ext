{
  "manifest_version": 3,
  "name": "Rox Discovery",
  "version": "6.5.0",
  "description": "Компактный анализ страницы • Markdown • Карта и Mindweb • Obsidian",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "tabs",
    "history",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webRequest",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "pzdrk_blocklist",
      "enabled": true,
      "path": "rules/blocklist.json"
    }]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rox Discovery",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["prompt-defaults.js", "workspace-map.js", "content.js"],
      "css": ["content.css", "workspace-map.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/pzdrk.png",
        "fonts/RoxMonoTypeface-SemiCondensed.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
